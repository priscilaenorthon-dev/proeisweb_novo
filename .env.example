# ── Credenciais PROEIS (obrigatórias) ─────────────────────────
PROEIS_LOGIN=           # Matrícula do voluntário
PROEIS_PASSWORD=        # Senha do PROEIS

# ── IA para resolução de CAPTCHA (obrigatória) ─────────────────
GEMINI_API_KEY=         # Chave do Google AI Studio (aistudio.google.com)

# ── Google Cloud / Firestore ───────────────────────────────────
# GOOGLE_APPLICATION_CREDENTIALS=/caminho/para/credenciais.json
FIRESTORE_DATABASE=proeis
FIRESTORE_EVENTS_COLLECTION=events

# ── CORS (opcional; padrão: * aceita qualquer origem) ─────────
# CORS_ORIGINS=https://seudominio.com,https://outro.com

# ── HTTP / Conexão (0 = usar padrão embutido) ─────────────────
# PROEIS_HTTP_ATTEMPTS=2
# PROEIS_CONNECT_TIMEOUT=8
# PROEIS_READ_TIMEOUT=25
# FILTER_MAX_ATTEMPTS=8

# ── Modelo Gemini (opcional) ──────────────────────────────────
# GEMINI_MODEL=gemini-2.5-pro
# GEMINI_PRO_FALLBACK_MODEL=gemini-2.5-pro
# GEMINI_PRO_FALLBACK_AFTER_REJECTS=1
# GEMINI_FLASH_THINKING_BUDGET=1024
# GEMINI_TIMEOUT=30

# ── Debug ─────────────────────────────────────────────────────
# PROEIS_DEBUG_MATCHES=1
