{
  "version": 2,
  "builds": [
    { "src": "api/index.py",   "use": "@vercel/python" },
    { "src": "web/index.html", "use": "@vercel/static" },
    { "src": "web/app.js",     "use": "@vercel/static" },
    { "src": "web/styles.css", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)",  "dest": "/api/index.py" },
    { "src": "/app.js",    "dest": "/web/app.js" },
    { "src": "/styles.css","dest": "/web/styles.css" },
    { "src": "/(.*)",      "dest": "/web/index.html" }
  ]
}
